rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Sessions: authenticated users can read, create, update; delete requires ownership
    match /receipt_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow any authenticated user to update (for joining sessions - app logic handles participant management)
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // User profiles: users can only read/write their own profile
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }
  }
}