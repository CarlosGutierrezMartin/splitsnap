{
  "name": "splitn",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Reparte la cuenta escaneando el ticket. PWA offline, sin cuentas ni servidores.",
  "scripts": {
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-models": "node scripts/fetch-models.mjs",
    "prepare-assets": "node scripts/fetch-models.mjs && node scripts/copy-ort.mjs",
    "make-icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.4.2",
    "framer-motion": "^12.23.26",
    "idb": "^8.0.3",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.4"
  }
}
